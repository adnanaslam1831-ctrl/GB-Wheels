# Copy to .env.local and fill in. Never commit .env.local.

# --- Database: Neon Postgres (Vercel Marketplace sets this for you) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Optional direct (non-pooled) URL used only for schema migration at build time.
DATABASE_URL_UNPOOLED=

# --- Photo storage: Vercel Blob (set automatically when a Blob store is connected) ---
BLOB_READ_WRITE_TOKEN=

# --- First Super Admin: the account registered with this email becomes Super Admin
#     (only while no Super Admin exists yet). Register it right after the first deploy. ---
ADMIN_EMAIL=

# --- Optional: password-reset emails via Resend. Without these, a Super Admin
#     issues one-time reset links from Admin > Users. ---
RESEND_API_KEY=
EMAIL_FROM=GB Wheels <no-reply@your-domain>

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Business contact details (placeholders until real details are supplied) ---
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=      # digits only with country code, e.g. 92XXXXXXXXXX
NEXT_PUBLIC_BUSINESS_EMAIL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=
